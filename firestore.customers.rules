// PROTOTYPE for Firestore Standard (default); verify target and existing rules first.
// clientesWeb/{uid}: uid string <=128, email string <=254, nombre 1..80,
// telefono 7..25, createdAt timestamp. All fields required and immutable.
// clientesPorEmail/{email}: trusted historical record; document ID must exactly match the verified Firebase Auth email.
// Only the verified owner of that exact email can get the document; no list or client writes.
// Users can only create/read their own verified profile. No updates/deletes/list.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }
    function isValidCustomer(d, uid) {
      return d.keys().hasAll(['uid','email','nombre','telefono','createdAt'])
        && d.keys().hasOnly(['uid','email','nombre','telefono','createdAt'])
        && d.uid is string && d.uid.size() > 0 && d.uid.size() <= 128
        && d.uid == uid && d.uid == request.auth.uid
        && d.email is string && d.email.size() > 3 && d.email.size() <= 254
        && d.email == request.auth.token.email
        && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 80
        && d.nombre.matches('.*[^ ].*')
        && d.telefono is string && d.telefono.size() >= 7 && d.telefono.size() <= 25
        && d.telefono.matches('^[+() 0-9-]{7,25}$')
        && d.createdAt is timestamp && d.createdAt == request.time;
    }
    match /clientesWeb/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid) && isValidCustomer(request.resource.data, uid);
      allow list, update, delete: if false;
    }
    match /clientesPorEmail/{email} {
      // Legacy records are imported by the center; a verified customer can only read their own email record.
      allow get: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == email;
      allow list, create, update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
