// Prototype for the default Firestore database; confirm its edition and deploy rules before use.
// Data model:
// clientesWeb/{uid}: uid, email, nombre (1..80), telefono (7..25), createdAt.
//   Customers can only create and read their own verified profile; no list/update/delete.
// clientesPorEmail/{email-lowercase}: email, nombre (1..80), telefono (7..25), createdAt.
//   Oasis can create a manual record; the verified matching customer can read only their own record.
// pagosManuales/{paymentId}: monto (0..100,000,000), dayKey (YYYY-MM-DD), createdAt, createdBy.
//   Only verified Oasis admins can read or create these payment records.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }

    function isOasisAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'oasysbeautycenter@gmail.com';
    }

    function isCustomerEmailOwner(email) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.lower() == email;
    }

    function isValidCustomer(d, uid) {
      return d.keys().hasAll(['uid','email','nombre','telefono','createdAt'])
        && d.keys().hasOnly(['uid','email','nombre','telefono','createdAt'])
        && d.uid is string && d.uid.size() > 0 && d.uid.size() <= 128
        && d.uid == uid && d.uid == request.auth.uid
        && d.email is string && d.email.size() > 3 && d.email.size() <= 254
        && d.email == request.auth.token.email
        && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 80
        && d.nombre.matches('.*[^ ].*')
        && d.telefono is string && d.telefono.size() >= 7 && d.telefono.size() <= 25
        && d.telefono.matches('^[+() 0-9-]{7,25}$')
        && d.createdAt is timestamp && d.createdAt == request.time;
    }

    function isValidManualCustomer(data, email) {
      return data.keys().hasAll(['email','nombre','telefono','createdAt'])
        && data.keys().hasOnly(['email','nombre','telefono','createdAt'])
        && data.email is string && data.email.size() > 3 && data.email.size() <= 254
        && data.email == email && data.email == email.lower()
        && data.email.matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+[.][A-Za-z]{2,}$')
        && data.nombre is string && data.nombre.size() > 0 && data.nombre.size() <= 80
        && data.nombre.matches('.*[^ ].*')
        && data.telefono is string && data.telefono.size() >= 7 && data.telefono.size() <= 25
        && data.telefono.matches('^[+() 0-9-]{7,25}$')
        && data.createdAt is timestamp && data.createdAt == request.time;
    }

    function isValidManualPayment(data) {
      return data.keys().hasAll(['monto','dayKey','createdAt','createdBy'])
        && data.keys().hasOnly(['monto','dayKey','createdAt','createdBy'])
        && data.monto is number && data.monto > 0 && data.monto <= 100000000
        && data.dayKey is string && data.dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.createdAt is timestamp && data.createdAt == request.time
        && data.createdBy is string
        && data.createdBy == request.auth.token.email.lower();
    }

    match /clientesWeb/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid) && isValidCustomer(request.resource.data, uid);
      allow list, update, delete: if false;
    }

    match /clientesPorEmail/{email} {
      // Admin may load a record. A verified customer may read only their own email record.
      allow get: if isCustomerEmailOwner(email) || isOasisAdmin();
      allow create: if isOasisAdmin() && isValidManualCustomer(request.resource.data, email);
      allow list, update, delete: if false;
    }

    match /pagosManuales/{paymentId} {
      allow get, list: if isOasisAdmin();
      allow create: if isOasisAdmin() && isValidManualPayment(request.resource.data);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
